# ============================================================================
# LOYERFACILE - FICHIER DE CONFIGURATION (à ne PAS committer)
# ============================================================================
# Copiez ce fichier en .env et remplacez les valeurs par les vôtres.
# Ce fichier n'est JAMAIS versionné (voir .gitignore).

# --------------------------
# Base de données MySQL
# ------------------------
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=votre_mot_de_passe
DB_NAME=loyerfacile

# --------------------------
# Sécurité (JWT)
# ------------------------
JWT_SECRET=choisissez_une_clé_secrète_longue_et_aléatoire
